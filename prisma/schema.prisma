datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password      String
  refreshToken  String?
  createdAt     DateTime @default(now())

  photos    Photo[]
  albums    Album[]
}

model Album {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  photos    Photo[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Photo {
  id        String   @id @default(uuid())

  s3Key     String   @unique
  thumbS3Key String?
  url       String

  filename  String
  mimeType  String
  size      Int

  lat       Float?
  lng       Float?
  favorite  Boolean  @default(false)
  tags      String[]
  blurred   Boolean  @default(false)
  blurScore Float?
  perceptualHash String?

  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  albums    Album[]

  @@index([userId])
  @@index([userId, favorite])
  @@index([userId, createdAt])
}
