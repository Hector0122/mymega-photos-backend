# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaulta

# JWT (run: openssl rand -hex 32)
JWT_SECRET=

# CORS (separar múltiples orígenes con coma, ej: http://localhost:3000,http://localhost:8081)
CORS_ORIGIN=*

# Auto-sync S3 a DB al arrancar (solo para migración inicial)
AUTO_SYNC_S3=false

# Bulk upload script (subir-masivo)
# Opción 1: token JWT directo
# BULK_TOKEN=
# Opción 2: email + password (se logea automático)
# BULK_EMAIL=
# BULK_PASSWORD=
# URL del backend (default: http://localhost:3000)
BACKEND_URL=http://localhost:3000

# SMTP para exportar por correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vaulta.app
